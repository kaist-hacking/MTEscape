 	old_cpu = PANIC_CPU_INVALID;
 	this_cpu = raw_smp_processor_id();
 
+#ifdef CONFIG_KASAN_HW_TAGS
+	/*
+	 * Hardware Tag-Based KASAN mitigation: prevent panic_cpu overwrites.
+	 *
+	 * An attacker could overwrite panic_cpu to force the panic-handling CPU
+	 * to call panic_smp_self_stop(), disabling panic handling.
+	 *
+	 * Use a random lock mechanism instead of fixed panic_cpu comparison:
+	 * - panic_random_lock_ro: read-only random value set at boot
+	 * - panic_random_lock: atomic lock initialized to panic_random_lock_ro
+	 *
+	 * Only the first CPU to exchange panic_random_lock_ro into panic_random_lock
+	 * proceeds with panic handling. Other CPUs stop themselves. This prevents
+	 * bypass via memory corruption since the lock value is unpredictable.
+	 */
+	extern int panic_random_lock_ro;
+	extern atomic_t panic_random_lock;
+	if (atomic_xchg(&panic_random_lock, panic_random_lock_ro) == panic_random_lock_ro)
+		panic_smp_self_stop();
+	atomic_set(&panic_cpu, this_cpu);
+#else
 	/* atomic_try_cmpxchg updates old_cpu on failure */
 	if (atomic_try_cmpxchg(&panic_cpu, &old_cpu, this_cpu)) {
 		/* go ahead */
 	} else if (old_cpu != this_cpu)
 		panic_smp_self_stop();
+#endif
 
 	console_verbose();
 	bust_spinlocks(1);
